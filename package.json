{
  "name": "buildhybridai-privacy-relay",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:rules": "firebase emulators:exec --only firestore --project demo-rules-test \"vitest run tests/firestore.rules.test.ts\"",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run --dir src",
    "test:privacy": "firebase emulators:exec --only auth,firestore --project buildhybridai-2026-fdbba \"node tests/e2e/privacy.mjs\"",
    "predev": "node scripts/copy-pdfjs.mjs",
    "prebuild": "node scripts/copy-pdfjs.mjs",
    "test:files": "node tests/e2e/files.mjs"
  },
  "dependencies": {
    "firebase": "13.1.0",
    "gliner": "0.0.19",
    "pdfjs-dist": "6.5.438",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "firebase-tools": "15.34.2",
    "globals": "^16.0.0",
    "playwright": "1.64.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vitest": "3.2.4"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "@firebase/util": false,
    "protobufjs": false
  }
}
